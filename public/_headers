/*
  Cross-Origin-Resource-Policy: cross-origin

# Service worker de la PWA: siempre revalidado, para que un cambio llegue en
# la siguiente visita.
/app-sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Modelos de IA alojados en el sitio. El nombre lleva la versión, así que nunca
# cambia el contenido de una misma URL: caché larga.
/models/*
  Cache-Control: public, max-age=31536000, immutable
