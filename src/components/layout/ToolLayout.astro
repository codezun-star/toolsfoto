---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { TOOLS, TOOL_BY_SLUG } from '@/lib/constants/tools';
import ToolCard from '@/components/ui/ToolCard';
import AdSlot from '@/components/ads/AdSlot.astro';
import AdNative from '@/components/ads/AdNative.astro';
import '@/styles/global.css';
import { PAGE_SEO, SITE } from '@/lib/constants/seo';
import { jsonLd } from '@/lib/utils/jsonld';

interface Props {
  slug: string;
  faqs?: Array<{ q: string; a: string }>;
  /** Respuesta directa de 1-2 frases. Es lo primero que lee un motor de respuesta. */
  answer?: string;
  /** Pasos propios para el schema HowTo. Si se omite se generan los del flujo estándar. */
  howTo?: string[];
  /** Fecha de última revisión del contenido (ISO YYYY-MM-DD). */
  dateModified?: string;
}

const { slug, faqs, answer = '', howTo, dateModified = SITE.dateModified } = Astro.props;
const tool = TOOL_BY_SLUG[slug];
const seo = PAGE_SEO[slug];
const related = TOOLS.filter(t => tool.related.includes(t.slug)).slice(0, 4);

const domainLabel: Record<string, string> = {
  imagen: 'Herramientas de imagen',
  pdf: 'Herramientas PDF',
  video: 'Herramientas de vídeo',
  audio: 'Herramientas de audio',
  developer: 'Herramientas para developers',
};

const domainHref: Record<string, string> = {
  imagen: `${SITE.url}/imagen`,
  pdf: `${SITE.url}/pdf`,
  video: `${SITE.url}/video`,
  audio: `${SITE.url}/audio`,
  developer: `${SITE.url}/developer`,
};

const appCategory: Record<string, string> = {
  imagen: 'MultimediaApplication',
  pdf: 'BusinessApplication',
  video: 'MultimediaApplication',
  audio: 'MultimediaApplication',
  developer: 'DeveloperApplication',
};

// Respuesta directa mostrada arriba del todo — extractable por motores de respuesta
const directAnswer = answer || tool.longDescription;

// Pasos por defecto según el tipo de herramienta (el flujo real del sitio)
const defaultSteps: Record<string, string[]> = {
  developer: [
    `Abre ${tool.name} e introduce el texto o los valores de entrada.`,
    'Ajusta las opciones disponibles según el resultado que necesites.',
    'Copia o descarga el resultado generado.',
  ],
  default: [
    `Arrastra tu archivo a ${tool.name} o pulsa para seleccionarlo. El archivo no se sube a ningún servidor.`,
    'Ajusta las opciones disponibles según el resultado que necesites.',
    'Pulsa el botón de procesar y descarga el archivo resultante.',
  ],
};
const howToSteps = howTo ?? defaultSteps[tool.domain] ?? defaultSteps.default;

const orgSchema = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon-192.png` },
  description: 'Herramientas online para imágenes, PDF, vídeo, audio y developers. 100% gratuitas, sin registro y sin subir archivos al servidor. Todo se procesa en tu navegador.',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'codezun@gmail.com',
    contactType: 'customer support',
    availableLanguage: 'Spanish',
  },
};

const siteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'es',
  publisher: { '@id': `${SITE.url}/#organization` },
};

const pageSchema = {
  '@type': 'WebPage',
  '@id': `${seo.canonical}#webpage`,
  url: seo.canonical,
  name: seo.title,
  description: seo.description,
  inLanguage: 'es',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@type': 'Thing', name: tool.name },
  dateModified,
  datePublished: SITE.datePublished,
  breadcrumb: { '@id': `${seo.canonical}#breadcrumb` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.aeo-answer'] },
};

const appSchema = {
  '@type': 'SoftwareApplication',
  '@id': `${seo.canonical}#app`,
  name: tool.name,
  description: tool.longDescription,
  url: seo.canonical,
  applicationCategory: appCategory[tool.domain] ?? 'MultimediaApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requiere JavaScript. Funciona en cualquier navegador moderno.',
  inLanguage: 'es',
  isAccessibleForFree: true,
  dateModified,
  featureList: [
    'Procesamiento 100% en el navegador, sin subir archivos a ningún servidor',
    'Sin registro ni instalación',
    'Sin marca de agua ni límite de archivos',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${seo.canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: domainLabel[tool.domain], item: domainHref[tool.domain] },
    { '@type': 'ListItem', position: 3, name: tool.name, item: seo.canonical },
  ],
};

const howToSchema = {
  '@type': 'HowTo',
  '@id': `${seo.canonical}#howto`,
  name: `Cómo usar ${tool.name}`,
  description: `Pasos para usar ${tool.name} en ${SITE.name}, gratis y sin subir archivos a ningún servidor.`,
  inLanguage: 'es',
  totalTime: 'PT1M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
  step: howToSteps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: `Paso ${i + 1}`,
    text,
    url: `${seo.canonical}#paso-${i + 1}`,
  })),
};

const faqSchema = faqs && faqs.length > 0
  ? {
      '@type': 'FAQPage',
      '@id': `${seo.canonical}#faq`,
      inLanguage: 'es',
      mainEntity: faqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    }
  : null;

const graph = jsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    orgSchema,
    siteSchema,
    pageSchema,
    appSchema,
    breadcrumbSchema,
    howToSchema,
    ...(faqSchema ? [faqSchema] : []),
  ],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" type="text/plain" href={`${SITE.url}/llms.txt`} title="Índice para motores de respuesta (llms.txt)" />

    <!-- Indexación: permite fragmentos completos en resultados y respuestas generadas -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={SITE.name} />
    <meta name="last-modified" content={dateModified} />

    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={SITE.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ToolsFoto — herramientas online para imagen, PDF, vídeo y audio" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:site_name" content="ToolsFoto" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={SITE.ogImage} />

    <!-- JSON-LD unificado en un @graph: Organization, WebSite, WebPage,
         SoftwareApplication, BreadcrumbList, HowTo y FAQPage -->
    <script is:inline type="application/ld+json" set:html={graph} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    {/* Monetag desactivado temporalmente — sitio sin anuncios por ahora */}
    {/* <meta name="monetag" content="7a8a8d7deccc95cced5ef94a9c6e3b73" /> */}
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JDPXVTKVCL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JDPXVTKVCL');
    </script>
  </head>
  <body>
    <Header />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <nav class="flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-8">
        <a href="/" class="hover:text-[var(--color-text)] transition-colors">Inicio</a>
        <span>/</span>
        <a href={`/${tool.domain}`} class="hover:text-[var(--color-text)] transition-colors">{domainLabel[tool.domain]}</a>
        <span>/</span>
        <span class="text-[var(--color-text)]">{tool.name}</span>
      </nav>

      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-text)] leading-tight">{tool.name}</h1>
        <p class="aeo-answer text-[var(--color-text-secondary)] mt-2 text-lg max-w-2xl">{directAnswer}</p>
        <p class="mt-3 text-xs text-[var(--color-text-muted)]">
          Gratis, sin registro y sin subir archivos a ningún servidor: el procesamiento ocurre en tu navegador ·
          <span> Actualizado el <time datetime={dateModified}>{new Date(`${dateModified}T00:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>
        </p>
      </div>

      {/* Anuncio superior: primer bloque tras la ficha, antes de la herramienta */}
      <AdSlot type="leaderboard" />

      <slot />

      {/* Anuncio tras el resultado: el usuario acaba de terminar su tarea */}
      <AdSlot type="rectangle" />

      {related.length > 0 && (
        <section class="mt-20">
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-5">Otras herramientas</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {related.map(t => <ToolCard tool={t} client:load />)}
          </div>
        </section>
      )}

      {/* Banner nativo: uno por página (id de contenedor fijo de la red) */}
      <AdNative />

      {faqs && faqs.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-extrabold text-[var(--color-text)] mb-6">Preguntas frecuentes</h2>
          <dl class="space-y-4">
            {faqs.map((faq) => (
              <div class="p-5 bg-white rounded-xl border border-[var(--color-border)]">
                <dt class="font-bold text-[var(--color-text)] mb-2">{faq.q}</dt>
                <dd class="text-[var(--color-text-secondary)] text-sm leading-relaxed">{faq.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </main>

    <Footer />
  </body>
</html>
