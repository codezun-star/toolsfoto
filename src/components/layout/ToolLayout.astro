---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { TOOLS, TOOL_BY_SLUG } from '@/lib/constants/tools';
import ToolCard from '@/components/ui/ToolCard';
import AdSlot from '@/components/ads/AdSlot.astro';
import AdNative from '@/components/ads/AdNative.astro';
import '@/styles/global.css';
import { PAGE_SEO, SITE } from '@/lib/constants/seo';
import { jsonLd } from '@/lib/utils/jsonld';
import AppMeta from './AppMeta.astro';
import NextSteps from '@/components/ui/NextSteps';
import FavoriteButton from '@/components/ui/FavoriteButton';
import { NEXT_STEPS, type FileKind } from '@/lib/constants/next-steps';
import EmbedSnippet from '@/components/ui/EmbedSnippet';
import { EMBED_BY_SLUG } from '@/lib/constants/embeds';
import { translator, LOCALE, type Lang } from '@/i18n';
import { EN_BY_ES, enPath } from '@/i18n/tools-en';

interface Props {
  slug: string;
  faqs?: Array<{ q: string; a: string }>;
  /** Respuesta directa de 1-2 frases. Es lo primero que lee un motor de respuesta. */
  answer?: string;
  /** Pasos propios para el schema HowTo. Si se omite se generan los del flujo estándar. */
  howTo?: string[];
  /** Fecha de última revisión del contenido (ISO YYYY-MM-DD). */
  dateModified?: string;
  /** Idioma de la página. En inglés, `slug` sigue siendo el español y el contenido sale de `tools-en.ts`. */
  lang?: Lang;
}

const { slug, faqs, answer = '', howTo, dateModified = SITE.dateModified, lang = 'es' } = Astro.props;
const t = translator(lang);
const en = lang === 'en';
const base = TOOL_BY_SLUG[slug];
const enTool = EN_BY_ES[slug];
if (en && !enTool) throw new Error(`[ToolLayout] «${slug}» no tiene versión en inglés en src/i18n/tools-en.ts`);

// Ficha y SEO en el idioma de la página. El dominio y el icono son los de la herramienta española.
const tool = en
  ? { ...base, slug: `en/${enTool.slug}`, name: enTool.name, description: enTool.description, longDescription: enTool.longDescription }
  : base;
const seo = en
  ? { title: enTool.title, description: enTool.metaDescription, canonical: `${SITE.url}/en/${enTool.slug}` }
  : PAGE_SEO[slug];

// hreflang: la misma herramienta en el otro idioma, si existe.
const esUrl = `${SITE.url}/${slug}`;
const enUrl = enPath(slug) ? `${SITE.url}${enPath(slug)}` : null;

// Relacionadas: en inglés solo las que tienen versión en inglés.
const related = en
  ? enTool.related.map((s) => EN_BY_ES[s] && TOOL_BY_SLUG[s] ? { ...TOOL_BY_SLUG[s], slug: `en/${EN_BY_ES[s].slug}`, name: EN_BY_ES[s].name, description: EN_BY_ES[s].description } : null)
      .filter((x): x is NonNullable<typeof x> => x !== null).slice(0, 4)
  : TOOLS.filter(t => base.related.includes(t.slug)).slice(0, 4);
const embed = en ? undefined : EMBED_BY_SLUG[slug];
const home = en ? '/en' : '/';

// "¿Y ahora?": siguientes herramientas por tipo de archivo, sin la actual.
const nextSteps = Object.fromEntries(
  (Object.keys(NEXT_STEPS) as FileKind[]).map((kind) => [
    kind,
    NEXT_STEPS[kind]
      .filter((s) => s !== slug && TOOL_BY_SLUG[s] && (!en || EN_BY_ES[s]))
      .slice(0, 6)
      .map((s) => (en ? { slug: `en/${EN_BY_ES[s].slug}`, name: EN_BY_ES[s].name } : { slug: s, name: TOOL_BY_SLUG[s].name })),
  ]),
) as Record<FileKind, Array<{ slug: string; name: string }>>;

const domainLabel: Record<string, string> = {
  imagen: t('Herramientas de imagen'),
  pdf: t('Herramientas PDF'),
  video: t('Herramientas de vídeo'),
  audio: t('Herramientas de audio'),
  developer: t('Herramientas para developers'),
};

// En inglés no hay páginas de categoría: la miga de pan va a la sección del home.
const EN_SECTION: Record<string, string> = { imagen: 'image', pdf: 'pdf', video: 'video', audio: 'audio', developer: 'developer' };
const domainPath = en ? `/en#${EN_SECTION[base.domain]}` : `/${base.domain}`;
const domainHref: Record<string, string> = { [base.domain]: `${SITE.url}${domainPath}` };

const appCategory: Record<string, string> = {
  imagen: 'MultimediaApplication',
  pdf: 'BusinessApplication',
  video: 'MultimediaApplication',
  audio: 'MultimediaApplication',
  developer: 'DeveloperApplication',
};

// Respuesta directa mostrada arriba del todo — extractable por motores de respuesta
const directAnswer = answer || tool.longDescription;

// Pasos por defecto según el tipo de herramienta (el flujo real del sitio)
const defaultSteps: Record<string, string[]> = {
  developer: [
    t('Abre {name} e introduce el texto o los valores de entrada.', { name: tool.name }),
    t('Ajusta las opciones disponibles según el resultado que necesites.'),
    t('Copia o descarga el resultado generado.'),
  ],
  default: [
    t('Arrastra tu archivo a {name} o pulsa para seleccionarlo. El archivo no se sube a ningún servidor.', { name: tool.name }),
    t('Ajusta las opciones disponibles según el resultado que necesites.'),
    t('Pulsa el botón de procesar y descarga el archivo resultante.'),
  ],
};
const howToSteps = howTo ?? defaultSteps[tool.domain] ?? defaultSteps.default;
const inLanguage = LOCALE[lang].html;

const orgSchema = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon-192.png` },
  description: t('Herramientas online para imágenes, PDF, vídeo, audio y developers. 100% gratuitas, sin registro y sin subir archivos al servidor. Todo se procesa en tu navegador.'),
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'codezun@gmail.com',
    contactType: 'customer support',
    availableLanguage: ['Spanish', 'English'],
  },
};

const siteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: t(SITE.description),
  inLanguage: ['es', 'en'],
  publisher: { '@id': `${SITE.url}/#organization` },
};

const pageSchema = {
  '@type': 'WebPage',
  '@id': `${seo.canonical}#webpage`,
  url: seo.canonical,
  name: seo.title,
  description: seo.description,
  inLanguage,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@type': 'Thing', name: tool.name },
  dateModified,
  datePublished: SITE.datePublished,
  breadcrumb: { '@id': `${seo.canonical}#breadcrumb` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.aeo-answer'] },
};

const appSchema = {
  '@type': 'SoftwareApplication',
  '@id': `${seo.canonical}#app`,
  name: tool.name,
  description: tool.longDescription,
  url: seo.canonical,
  applicationCategory: appCategory[tool.domain] ?? 'MultimediaApplication',
  operatingSystem: 'Web',
  browserRequirements: t('Requiere JavaScript. Funciona en cualquier navegador moderno.'),
  inLanguage,
  isAccessibleForFree: true,
  dateModified,
  featureList: [
    t('Procesamiento 100% en el navegador, sin subir archivos a ningún servidor'),
    t('Sin registro ni instalación'),
    t('Sin marca de agua ni límite de archivos'),
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': `${SITE.url}/#organization` },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${seo.canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('Inicio'), item: en ? `${SITE.url}/en` : SITE.url },
    { '@type': 'ListItem', position: 2, name: domainLabel[tool.domain], item: domainHref[tool.domain] },
    { '@type': 'ListItem', position: 3, name: tool.name, item: seo.canonical },
  ],
};

const howToSchema = {
  '@type': 'HowTo',
  '@id': `${seo.canonical}#howto`,
  name: t('Cómo usar {name}', { name: tool.name }),
  description: t('Pasos para usar {name} en {site}, gratis y sin subir archivos a ningún servidor.', { name: tool.name, site: SITE.name }),
  inLanguage,
  totalTime: 'PT1M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
  step: howToSteps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: t('Paso {n}', { n: i + 1 }),
    text,
    url: `${seo.canonical}#${en ? 'step' : 'paso'}-${i + 1}`,
  })),
};

const faqSchema = faqs && faqs.length > 0
  ? {
      '@type': 'FAQPage',
      '@id': `${seo.canonical}#faq`,
      inLanguage,
      mainEntity: faqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    }
  : null;

const graph = jsonLd({
  '@context': 'https://schema.org',
  '@graph': [
    orgSchema,
    siteSchema,
    pageSchema,
    appSchema,
    breadcrumbSchema,
    howToSchema,
    ...(faqSchema ? [faqSchema] : []),
  ],
});
---

<!doctype html>
<html lang={LOCALE[lang].html}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {enUrl && (
      <>
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />
      </>
    )}
    <link rel="alternate" type="text/plain" href={`${SITE.url}/llms.txt`} title={t('Índice para motores de respuesta (llms.txt)')} />

    <!-- Indexación: permite fragmentos completos en resultados y respuestas generadas -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={SITE.name} />
    <meta name="last-modified" content={dateModified} />

    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={SITE.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('ToolsFoto — herramientas online para imagen, PDF, vídeo y audio')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:site_name" content="ToolsFoto" />
    <meta property="og:locale" content={LOCALE[lang].og} />
    {enUrl && <meta property="og:locale:alternate" content={en ? 'es_ES' : 'en_US'} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={SITE.ogImage} />

    <!-- JSON-LD unificado en un @graph: Organization, WebSite, WebPage,
         SoftwareApplication, BreadcrumbList, HowTo y FAQPage -->
    <script is:inline type="application/ld+json" set:html={graph} />

    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <AppMeta />
    {/* Monetag desactivado temporalmente — sitio sin anuncios por ahora */}
    {/* <meta name="monetag" content="7a8a8d7deccc95cced5ef94a9c6e3b73" /> */}
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JDPXVTKVCL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JDPXVTKVCL');
    </script>
  </head>
  <body>
    <Header back={domainPath} title={tool.name} lang={lang} alternate={en ? `/${slug}` : enPath(slug) ?? undefined} />

    <main data-tool-slug={slug} class="max-w-6xl mx-auto px-4 sm:px-6 pt-5 pb-10 sm:py-10">
      {/* En móvil la miga de pan la sustituyen el botón atrás de la barra
          superior y la pestaña activa; sigue en el HTML para los buscadores. */}
      <nav class="hidden md:flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-8">
        <a href={home} class="hover:text-[var(--color-text)] transition-colors">{t('Inicio')}</a>
        <span>/</span>
        <a href={domainPath} class="hover:text-[var(--color-text)] transition-colors">{domainLabel[tool.domain]}</a>
        <span>/</span>
        <span class="text-[var(--color-text)]">{tool.name}</span>
      </nav>

      <div class="mb-6 sm:mb-8">
        <div class="flex items-start justify-between gap-3">
          <h1 class="text-[28px] sm:text-4xl font-extrabold text-[var(--color-text)] leading-tight">{tool.name}</h1>
          {!en && <FavoriteButton slug={slug} client:load />}
        </div>
        <p class="aeo-answer text-[var(--color-text-secondary)] mt-2 text-base sm:text-lg max-w-2xl">{directAnswer}</p>
        <p class="mt-3 text-xs text-[var(--color-text-muted)]">
          {t('Gratis, sin registro y sin subir archivos a ningún servidor: el procesamiento ocurre en tu navegador')} ·
          <span> {t('Actualizado el')} <time datetime={dateModified}>{new Date(`${dateModified}T00:00:00Z`).toLocaleDateString(en ? 'en-US' : 'es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></span>
        </p>
      </div>

      {/* Anuncio superior: primer bloque tras la ficha, antes de la herramienta */}
      <AdSlot type="leaderboard" />

      <slot />

      {/* "¿Y ahora?": aparece al descargar un resultado */}
      <NextSteps steps={nextSteps} lang={lang} client:load />

      {/* Anuncio tras el resultado: el usuario acaba de terminar su tarea */}
      <AdSlot type="rectangle" />

      {related.length > 0 && (
        <section class="mt-20">
          <h2 class="text-xl font-bold text-[var(--color-text)] mb-5">{t('Otras herramientas')}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {related.map(t => <ToolCard tool={t} client:load />)}
          </div>
        </section>
      )}

      {/* Widget incrustable: código para insertar la herramienta en otra web (backlink) */}
      {embed && <EmbedSnippet slug={slug} name={tool.name} height={embed.height} client:visible />}

      {/* Banner nativo: uno por página (id de contenedor fijo de la red) */}
      <AdNative />

      {faqs && faqs.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-extrabold text-[var(--color-text)] mb-6">{t('Preguntas frecuentes')}</h2>
          <dl class="space-y-4">
            {faqs.map((faq) => (
              <div class="p-5 bg-white rounded-xl border border-[var(--color-border)]">
                <dt class="font-bold text-[var(--color-text)] mb-2">{faq.q}</dt>
                <dd class="text-[var(--color-text-secondary)] text-sm leading-relaxed">{faq.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </main>

    <Footer lang={lang} alternate={en ? `/${slug}` : enPath(slug) ?? undefined} />

    <script>
      import { installResultCapture } from '@/lib/utils/results';
      import { recordRecent } from '@/lib/utils/recent';

      installResultCapture();
      // Recientes solo en español: el índice del buscador (y por tanto «Tus herramientas») es el español.
      const toolSlug = document.querySelector<HTMLElement>('[data-tool-slug]')?.dataset.toolSlug;
      if (toolSlug && document.documentElement.lang === 'es') recordRecent(toolSlug);
    </script>
  </body>
</html>
