---
import AdScripts from './AdScripts.astro';
import AppShell from './AppShell.astro';
import { TOOLS, TOOL_BY_SLUG } from '@/lib/constants/tools';
import { EN_TOOLS } from '@/i18n/tools-en';
import type { Lang } from '@/i18n';

interface Props {
  lang?: Lang;
  /** La misma página en el otro idioma. */
  alternate?: string;
}

const { lang = 'es', alternate } = Astro.props;
const en = lang === 'en';
const year = new Date().getFullYear();

// Pie en inglés: las herramientas traducidas de cada dominio.
const EN_COLUMNS = [
  { domain: 'imagen', label: 'Image', anchor: 'image' },
  { domain: 'pdf', label: 'PDF', anchor: 'pdf' },
  { domain: 'video', label: 'Video', anchor: 'video' },
  { domain: 'developer', label: 'Developer', anchor: 'developer' },
].map((c) => ({ ...c, tools: EN_TOOLS.filter((t) => TOOL_BY_SLUG[t.es]?.domain === c.domain).slice(0, 5) }))
  .filter((c) => c.tools.length > 0);
---
<footer class="site-footer border-t border-[var(--color-border)] bg-white mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    {en ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 mb-8 text-sm">
        {EN_COLUMNS.map((c) => (
          <div>
            <p class="font-bold text-[var(--color-text)] mb-3">{c.label}</p>
            <nav class="space-y-2 text-[var(--color-text-muted)]">
              {c.tools.map((t) => <a href={`/en/${t.slug}`} class="block hover:text-[var(--color-text)] transition-colors">{t.name}</a>)}
              <a href={`/en#${c.anchor}`} class="block hover:text-[var(--color-accent)] transition-colors text-xs mt-1">See all →</a>
            </nav>
          </div>
        ))}
        <div>
          <p class="font-bold text-[var(--color-text)] mb-3">ToolsFoto</p>
          <nav class="space-y-2 text-[var(--color-text-muted)]">
            <a href="/en" class="block hover:text-[var(--color-text)] transition-colors">Home</a>
            <a href={alternate ?? '/'} hreflang="es" lang="es" class="block hover:text-[var(--color-text)] transition-colors">Español ({TOOLS.length} herramientas)</a>
            <a href="/contacto" class="block hover:text-[var(--color-text)] transition-colors">Contact <span class="text-xs">(ES)</span></a>
            <a href="/privacidad" class="block hover:text-[var(--color-text)] transition-colors">Privacy <span class="text-xs">(ES)</span></a>
            <a href="/terminos" class="block hover:text-[var(--color-text)] transition-colors">Terms <span class="text-xs">(ES)</span></a>
          </nav>
        </div>
      </div>
    ) : (
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 mb-8 text-sm">
      <div>
        <p class="font-bold text-[var(--color-text)] mb-3">Imágenes</p>
        <nav class="space-y-2 text-[var(--color-text-muted)]">
          <a href="/comprimir" class="block hover:text-[var(--color-text)] transition-colors">Comprimir</a>
          <a href="/redimensionar" class="block hover:text-[var(--color-text)] transition-colors">Redimensionar</a>
          <a href="/convertir" class="block hover:text-[var(--color-text)] transition-colors">Convertir</a>
          <a href="/recortar" class="block hover:text-[var(--color-text)] transition-colors">Recortar</a>
          <a href="/#imagen" class="block hover:text-[var(--color-accent)] transition-colors text-xs mt-1">Ver todas →</a>
        </nav>
      </div>
      <div>
        <p class="font-bold text-[var(--color-text)] mb-3">PDF</p>
        <nav class="space-y-2 text-[var(--color-text-muted)]">
          <a href="/comprimir-pdf" class="block hover:text-[var(--color-text)] transition-colors">Comprimir PDF</a>
          <a href="/unir-pdfs" class="block hover:text-[var(--color-text)] transition-colors">Unir PDFs</a>
          <a href="/pdf-a-jpg" class="block hover:text-[var(--color-text)] transition-colors">PDF a JPG</a>
          <a href="/jpg-a-pdf" class="block hover:text-[var(--color-text)] transition-colors">JPG a PDF</a>
          <a href="/#pdf" class="block hover:text-[var(--color-accent)] transition-colors text-xs mt-1">Ver todas →</a>
        </nav>
      </div>
      <div>
        <p class="font-bold text-[var(--color-text)] mb-3">Vídeo</p>
        <nav class="space-y-2 text-[var(--color-text-muted)]">
          <a href="/comprimir-video" class="block hover:text-[var(--color-text)] transition-colors">Comprimir vídeo</a>
          <a href="/convertir-video" class="block hover:text-[var(--color-text)] transition-colors">Convertir vídeo</a>
          <a href="/extraer-audio" class="block hover:text-[var(--color-text)] transition-colors">Extraer audio</a>
          <a href="/video-a-gif" class="block hover:text-[var(--color-text)] transition-colors">Vídeo a GIF</a>
          <a href="/#video" class="block hover:text-[var(--color-accent)] transition-colors text-xs mt-1">Ver todas →</a>
        </nav>
      </div>
      <div>
        <p class="font-bold text-[var(--color-text)] mb-3">Audio</p>
        <nav class="space-y-2 text-[var(--color-text-muted)]">
          <a href="/comprimir-audio" class="block hover:text-[var(--color-text)] transition-colors">Comprimir audio</a>
          <a href="/convertir-audio" class="block hover:text-[var(--color-text)] transition-colors">Convertir audio</a>
          <a href="/cortar-audio" class="block hover:text-[var(--color-text)] transition-colors">Cortar audio</a>
          <a href="/unir-audios" class="block hover:text-[var(--color-text)] transition-colors">Unir audios</a>
          <a href="/#audio" class="block hover:text-[var(--color-accent)] transition-colors text-xs mt-1">Ver todas →</a>
        </nav>
      </div>
      <div>
        <p class="font-bold text-[var(--color-text)] mb-3">Developer</p>
        <nav class="space-y-2 text-[var(--color-text-muted)]">
          <a href="/generar-qr" class="block hover:text-[var(--color-text)] transition-colors">Generar QR</a>
          <a href="/formatear-json" class="block hover:text-[var(--color-text)] transition-colors">Formatear JSON</a>
          <a href="/generador-contrasenas" class="block hover:text-[var(--color-text)] transition-colors">Contraseñas</a>
          <a href="/convertir-color" class="block hover:text-[var(--color-text)] transition-colors">Convertir color</a>
          <a href="/developer" class="block hover:text-[var(--color-accent)] transition-colors text-xs mt-1">Ver todas →</a>
        </nav>
      </div>
      <div>
        <p class="font-bold text-[var(--color-text)] mb-3">ToolsFoto</p>
        <nav class="space-y-2 text-[var(--color-text-muted)]">
          <a href="/" class="block hover:text-[var(--color-text)] transition-colors">Inicio</a>
          <a href="/blog" class="block hover:text-[var(--color-text)] transition-colors">Blog</a>
          <a href="/widgets" class="block hover:text-[var(--color-text)] transition-colors">Widgets para tu web</a>
          <a href="/contacto" class="block hover:text-[var(--color-text)] transition-colors">Contacto</a>
          <a href="/privacidad" class="block hover:text-[var(--color-text)] transition-colors">Privacidad</a>
          <a href="/terminos" class="block hover:text-[var(--color-text)] transition-colors">Términos</a>
          <a href="/en" hreflang="en" lang="en" class="block hover:text-[var(--color-text)] transition-colors">English</a>
        </nav>
      </div>
    </div>
    )}
    <div class="border-t border-[var(--color-border)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--color-text-muted)]">
      {en
        ? <p>© {year} ToolsFoto · {EN_TOOLS.length} tools in English · Your files never leave your device</p>
        : <p>© {year} ToolsFoto · {TOOLS.length} herramientas · Tus archivos nunca salen de tu dispositivo</p>}
      <a href="/cookies" class="hover:text-[var(--color-text)] transition-colors">{en ? 'Cookie policy (ES)' : 'Política de cookies'}</a>
    </div>
  </div>
</footer>
{/* Barra de pestañas, menú, buscador y PWA — fuera del <footer> a propósito:
    en la app instalada el pie se oculta y esto tiene que seguir visible. */}
<AppShell lang={lang} />
<AdScripts />
