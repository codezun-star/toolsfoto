---
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BlogList from '@/components/blog/BlogList';
import AdSlot from '@/components/ads/AdSlot.astro';
import AdNative from '@/components/ads/AdNative.astro';
import '@/styles/global.css';
import { SITE } from '@/lib/constants/seo';
import { getCollection } from 'astro:content';
import { jsonLd } from '@/lib/utils/jsonld';

const todos = await getCollection('blog', (e) => e.data.publicado !== false);
const sorted = todos
  .sort((a, b) => b.data.fecha.localeCompare(a.data.fecha))
  .map((art) => ({
    id:          art.id,
    titulo:      art.data.titulo,
    descripcion: art.data.descripcion ?? '',
    categoria:   art.data.categoria,
  }));

const title = 'Blog de ToolsFoto — Guías, Tips y Tutoriales de Imagen, PDF y Vídeo';
const description = 'Tutoriales, guías y tips sobre compresión de imágenes, edición de PDF, conversión de vídeo y audio. Aprende a sacar el máximo partido a las herramientas gratuitas de ToolsFoto.';
const canonical = `${SITE.url}/blog`;

// El artículo más reciente marca la frescura del listado.
const lastUpdated = sorted.length > 0
  ? todos.reduce((max, a) => (a.data.fecha > max ? a.data.fecha : max), todos[0].data.fecha)
  : SITE.dateModified;

const orgSchema = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon-192.png`, width: 192, height: 192 },
};

const siteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'es',
  publisher: { '@id': `${SITE.url}/#organization` },
};

// `Blog` + `ItemList`: sin esto los 49 artículos no se declaran como colección
// y el listado solo aportaba una miga de pan.
const blogSchema = {
  '@type': 'Blog',
  '@id': `${canonical}#blog`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'es',
  isPartOf: { '@id': `${SITE.url}/#website` },
  publisher: { '@id': `${SITE.url}/#organization` },
  dateModified: `${lastUpdated}T00:00:00Z`,
  breadcrumb: { '@id': `${canonical}#breadcrumb` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: sorted.length,
    itemListElement: sorted.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.titulo,
      url: `${SITE.url}/blog/${a.id}`,
    })),
  },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: canonical },
  ],
};

const graph = jsonLd({
  '@context': 'https://schema.org',
  '@graph': [orgSchema, siteSchema, blogSchema, breadcrumbSchema],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={SITE.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ToolsFoto — herramientas online para imagen, PDF, vídeo y audio" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ToolsFoto" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE.ogImage} />

    <!-- JSON-LD unificado en un @graph: Organization, WebSite, Blog con el
         ItemList de todos los artículos, y BreadcrumbList -->
    <script is:inline type="application/ld+json" set:html={graph} />

    <meta name="theme-color" content="#E84827" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    {/* Monetag desactivado temporalmente — sitio sin anuncios por ahora */}
    {/* <meta name="monetag" content="7a8a8d7deccc95cced5ef94a9c6e3b73" /> */}
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JDPXVTKVCL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JDPXVTKVCL');
    </script>
  </head>
  <body>
    <Header />

    <!-- Page header -->
    <div class="bg-[var(--color-text)] pt-14">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
        <nav class="flex items-center gap-2 text-xs text-[#888] mb-6 font-mono">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <span>/</span>
          <span style="color: #0BBFB0;">Blog</span>
        </nav>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white leading-tight mb-3" style="letter-spacing: -0.5px;">
          Blog
        </h1>
        <p class="text-[#999] text-base max-w-xl leading-relaxed">
          Guías, tips y tutoriales sobre imagen, PDF, vídeo y audio. Sin rodeos.
        </p>
      </div>
    </div>

    <!-- Article list -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 min-h-[60vh]">
      <AdSlot type="leaderboard" />
      <BlogList articles={sorted} client:load />
      <AdNative />
    </main>

    <Footer />
  </body>
</html>
