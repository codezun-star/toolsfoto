---
/**
 * /offline — la muestra el service worker (`public/app-sw.js`) cuando no hay
 * conexión y la página pedida no está guardada en el dispositivo.
 *
 * Autocontenida a propósito: estilos y script en línea, sin global.css ni
 * anuncios ni analytics. Sin conexión solo se puede servir lo que ya esté en
 * caché, y esta página se precachea sola al instalar el service worker.
 * noindex y fuera del sitemap (filtro en astro.config.mjs).
 */
import { WifiOff } from 'lucide-react';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sin conexión | ToolsFoto</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <style is:inline>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-tap-highlight-color: transparent; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        min-height: 100vh;
        background: #F5F3EF;
        color: #111110;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .bar {
        position: sticky;
        top: 0;
        height: 56px;
        display: flex;
        align-items: center;
        padding: 0 16px;
        background: #fff;
        border-bottom: 1px solid #E8E4DE;
      }
      .logo { font-size: 20px; font-weight: 800; letter-spacing: -0.5px; color: #111110; text-decoration: none; }
      .logo span { color: #0BBFB0; }
      main { max-width: 480px; margin: 0 auto; padding: 48px 20px calc(48px + env(safe-area-inset-bottom, 0px)); text-align: center; }
      .icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 20px;
        display: grid;
        place-items: center;
        border-radius: 22px;
        background: #FEF0ED;
        color: #E84827;
      }
      h1 { margin: 0 0 10px; font-size: 26px; font-weight: 800; }
      p { margin: 0 0 24px; color: #706C66; line-height: 1.55; }
      .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
      .btn {
        display: inline-flex;
        align-items: center;
        height: 46px;
        padding: 0 22px;
        border: 1px solid #E8E4DE;
        border-radius: 999px;
        background: #fff;
        color: #111110;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }
      .btn-primary { background: #E84827; border-color: #E84827; color: #fff; }
      .btn:active { transform: scale(0.96); }
      .saved { margin-top: 40px; text-align: left; }
      .saved h2 {
        margin: 0 0 8px 4px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #A8A49E;
      }
      .saved ul { margin: 0; padding: 0; list-style: none; background: #fff; border: 1px solid #E8E4DE; border-radius: 16px; overflow: hidden; }
      .saved li + li { border-top: 1px solid #E8E4DE; }
      .saved a { display: block; padding: 14px 16px; color: #111110; font-weight: 600; text-decoration: none; }
      .note { margin-top: 16px; font-size: 13px; color: #A8A49E; }
    </style>
  </head>
  <body>
    <header class="bar">
      <a href="/" class="logo">Tools<span>Foto</span></a>
    </header>
    <main>
      <div class="icon"><WifiOff size={32} /></div>
      <h1>Sin conexión</h1>
      <p>No hay conexión a internet. Las páginas que ya has visitado se guardan en tu dispositivo y puedes volver a abrirlas sin conexión.</p>
      <div class="actions">
        <button type="button" class="btn btn-primary" id="retry">Reintentar</button>
        <a href="/" class="btn">Ir al inicio</a>
      </div>
      <section class="saved" id="saved" hidden>
        <h2>Disponibles sin conexión</h2>
        <ul id="saved-list"></ul>
        <p class="note">Las herramientas de vídeo, audio y quitar fondo necesitan conexión la primera vez para descargar su procesador.</p>
      </section>
    </main>
    <script is:inline>
      document.getElementById('retry').addEventListener('click', function () { location.reload(); });
      window.addEventListener('online', function () { location.reload(); });

      // Lista las páginas que el service worker tiene guardadas (caché tf-pages-*).
      (async function () {
        if (!('caches' in window)) return;
        try {
          var names = (await caches.keys()).filter(function (n) { return n.indexOf('tf-pages-') === 0; });
          var items = [];
          for (var i = 0; i < names.length; i++) {
            var cache = await caches.open(names[i]);
            var keys = await cache.keys();
            for (var k = 0; k < keys.length; k++) {
              var url = new URL(keys[k].url);
              if (url.pathname === location.pathname) continue;
              var res = await cache.match(keys[k]);
              var html = res ? await res.text() : '';
              var m = html.match(/<title>([^<]*)<\/title>/i);
              var title = m ? m[1].replace(/\s*[|·–-]\s*ToolsFoto\s*$/i, '').trim() : url.pathname;
              var tmp = document.createElement('textarea');
              tmp.innerHTML = title;
              items.push({ href: url.pathname, title: tmp.value || url.pathname });
            }
          }
          if (!items.length) return;
          var list = document.getElementById('saved-list');
          items.reverse().slice(0, 30).forEach(function (it) {
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = it.href;
            a.textContent = it.title;
            li.appendChild(a);
            list.appendChild(li);
          });
          document.getElementById('saved').hidden = false;
        } catch (e) {
          /* sin caché accesible: se queda el mensaje básico */
        }
      })();
    </script>
  </body>
</html>
